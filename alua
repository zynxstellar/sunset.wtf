    local bar = new("TextButton", { Size = UDim2.new(1, 0, 0, 10), Position = UDim2.fromOffset(0, 26), BackgroundColor3 = T.element, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, holder)
