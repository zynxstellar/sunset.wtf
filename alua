        entityInstance = target.model,
        chargedAttack = { chargeRatio = 0 },
        validate = {
            raycast = {
                cameraPosition = { value = cameraPosition },
                cursorDirection = { value = delta.Unit },
            },
            selfPosition = { value = root.Position },
            targetPosition = { value = target.root.Position },
        },
