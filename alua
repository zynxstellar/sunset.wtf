        if Settings.SelectedGame == "BedWars" and BedWars.SprintOn then
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if humanoid ~= BedWars.SprintHumanoid then
                    BedWars.SprintHumanoid = humanoid
                    BedWars.SprintBaseSpeed = math.max(16, humanoid.WalkSpeed)
                    BedWars.SprintFallbackSpeed = nil
                end
                local controller = bedWarsSprintController()
                local start = controller and (controller.startSprinting or controller.startSprint)
                if controller and controller.sprinting ~= true then
                    if type(start) == "function" then
                        pcall(start, controller)
                    elseif type(controller.setSprinting) == "function" then
                        pcall(controller.setSprinting, controller, true)
                    end
                end
                local base = BedWars.SprintBaseSpeed or 16
                local boosted = math.max(20, base * 1.35)
                if controller and type(controller.setSpeed) == "function"
                    and humanoid.WalkSpeed < boosted - 0.1 then
                    pcall(controller.setSpeed, controller, boosted)
                end
                BedWars.SprintFallbackSpeed = boosted
