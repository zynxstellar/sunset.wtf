    local InstantKill = flagModule()
    Zombie.InstantKill = InstantKill
    local hitBurstSize = 32
    local lastHitBurst = {}
    local gunHitRemote = remote(Core.GunRemotes, "GunHit")
    local canBurstHits = gunHitRemote and typeof(hookmetamethod) == "function"
        and typeof(newcclosure) == "function" and typeof(getnamecallmethod) == "function"
    function InstantKill.SetEnabled(state)
        InstantKill.enabled = state == true and canBurstHits == true
        if state and not canBurstHits then
            warn("[Sunset] Instant Kill needs the GunHit remote and namecall hooks")
        end
        if not InstantKill.enabled then table.clear(lastHitBurst) end
    end
    function InstantKill.SetBurstSize(value)
        hitBurstSize = math.clamp(math.floor(tonumber(value) or 32), 2, 64)
    end
    if canBurstHits then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            if self == gunHitRemote and getnamecallmethod() == "FireServer"
                and Zombie.alive and InstantKill.enabled then
                local args = table.pack(...)
                local zombieId = args[2]
                if zombieId and zombieId ~= 0 and args[4] ~= true
                    and os.clock() - (lastHitBurst[zombieId] or -math.huge) >= 0.35 then
                    lastHitBurst[zombieId] = os.clock()
                    local result = oldNamecall(self, ...)
                    task.spawn(function()
                        for i = 2, hitBurstSize do
                            if not Zombie.alive or not InstantKill.enabled then break end
                            pcall(function()
                                self:FireServer(table.unpack(args, 1, args.n))
                            end)
                            if i % 8 == 0 then task.wait() end
                        end
                    end)
                    return result
                end
            end
            return oldNamecall(self, ...)
        end))
    end
    function Zombie.Stop()
        Zombie.alive = false
        for _, module in ipairs({ AutoReplay, AutoNextWave, AutoSkipWave, AutoEquip,
            KillAura }) do module.SetEnabled(false) end
        Crosshair.SetEnabled(false)
        Upgrades.SetHealthEnabled(false)
        Upgrades.SetWeaponEnabled(false)
        ZombieRadar.SetEnabled(false)
        DropMarkers.SetEnabled(false)
        AutoAbility.SetEnabled(false)
        RapidFire.SetEnabled(false)
        BulletNoClip.SetEnabled(false)
        InstantKill.SetEnabled(false)
    end
end

