        Size = UDim2.fromOffset(400, 306), Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(16, 17, 23),
        BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 1001,
    }, Gui)
    new("UICorner", { CornerRadius = UDim.new(0, 14) }, picker)
    border(picker, Color3.fromRGB(66, 39, 48), 1)
    local pickerScale = new("UIScale", { Scale = 0.94 }, picker)
    local function text(parent, value, x, y, w, h, size, color, font)
        return new("TextLabel", {
            Text = value, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
            BackgroundTransparency = 1, Font = font or Enum.Font.Gotham,
            TextSize = size, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Left,
        }, parent)
    end
    text(picker, "SUNSET.WTF", 26, 22, 348, 22, 15, T.red, Enum.Font.GothamBold)
    text(picker, "Choose your game", 26, 57, 348, 32, 24, T.text, Enum.Font.GothamBold)
    local gameButton = new("TextButton", {
        Position = UDim2.fromOffset(26, 110), Size = UDim2.fromOffset(348, 72),
        BackgroundColor3 = Color3.fromRGB(35, 23, 30), BorderSizePixel = 0,
        Text = "", AutoButtonColor = false,
    }, picker)
    new("UICorner", { CornerRadius = UDim.new(0, 9) }, gameButton)
    local gameBorder = border(gameButton, T.red, 1)
    local reticle = new("Frame", {
        Position = UDim2.fromOffset(19, 21), Size = UDim2.fromOffset(30, 30),
        BackgroundTransparency = 1,
    }, gameButton)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, reticle)
    border(reticle, T.red, 2)
    new("Frame", { Size = UDim2.fromOffset(40, 2), Position = UDim2.fromOffset(-5, 14), BackgroundColor3 = T.red, BorderSizePixel = 0 }, reticle)
    new("Frame", { Size = UDim2.fromOffset(2, 40), Position = UDim2.fromOffset(14, -5), BackgroundColor3 = T.red, BorderSizePixel = 0 }, reticle)
    text(gameButton, "Sniper Duels", 70, 23, 240, 26, 18, T.text, Enum.Font.GothamBold)
    local otherButton = new("TextButton", {
        Position = UDim2.fromOffset(26, 196), Size = UDim2.fromOffset(348, 44),
        BackgroundColor3 = Color3.fromRGB(26, 28, 36), BorderSizePixel = 0,
        Text = "My game's not on here", Font = Enum.Font.Gotham, TextSize = 14,
        TextColor3 = T.dim, AutoButtonColor = false,
    }, picker)
    new("UICorner", { CornerRadius = UDim.new(0, 8) }, otherButton)
    text(picker, "BY ZYNX", 26, 264, 348, 18, 10, T.dim)
    local intro = new("CanvasGroup", {
        Size = UDim2.fromOffset(400, 330), Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(12, 13, 19),
        BorderSizePixel = 0, GroupTransparency = 1, Visible = false, ZIndex = 1002,
    }, Gui)
    new("UICorner", { CornerRadius = UDim.new(0, 16) }, intro)
    local edge = border(intro, T.red, 1)
    local introScale = new("UIScale", { Scale = 0.94 }, intro)
    local orbitGradients = {}
    for i = 1, 3 do
        local diameter = 84 + i*22
        local circle = new("Frame", {
            Size = UDim2.fromOffset(diameter, diameter),
            Position = UDim2.fromOffset(200, 108), AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 1,
        }, intro)
        new("UICorner", { CornerRadius = UDim.new(1, 0) }, circle)
        local line = border(circle, i == 2 and Color3.fromRGB(250, 153, 114) or T.red, i == 2 and 2 or 1)
        local gradient = new("UIGradient", {
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.98),
                NumberSequenceKeypoint.new(0.5, 0.08),
                NumberSequenceKeypoint.new(1, 0.98),
            }),
            Rotation = i*75,
        }, line)
        table.insert(orbitGradients, gradient)
    end
    local monogram = text(intro, "S", 160, 74, 80, 68, 54, T.text, Enum.Font.GothamBold)
    monogram.TextXAlignment = Enum.TextXAlignment.Center
    local brand = text(intro, "SUNSET.WTF", 30, 192, 340, 36, 27, T.text, Enum.Font.GothamBold)
    brand.TextXAlignment = Enum.TextXAlignment.Center
    local shine = new("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, T.red),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 228, 211)),
            ColorSequenceKeypoint.new(1, T.red),
        }),
    }, brand)
    local gameText = text(intro, "", 30, 236, 340, 18, 12, T.dim)
    gameText.TextXAlignment = Enum.TextXAlignment.Center
    local bar = new("Frame", {
        Position = UDim2.fromOffset(34, 277), Size = UDim2.fromOffset(332, 3),
        BackgroundColor3 = Color3.fromRGB(38, 30, 38), BorderSizePixel = 0,
    }, intro)
    local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.red, BorderSizePixel = 0 }, bar)
    local percent = text(intro, "0%", 34, 292, 332, 16, 10, T.dim)
    percent.TextXAlignment = Enum.TextXAlignment.Right
    local particles = {}
    for i = 1, 12 do
        local dot = new("Frame", {
            Size = UDim2.fromOffset(i%3 == 0 and 3 or 2, i%3 == 0 and 3 or 2),
            BackgroundColor3 = T.red, BackgroundTransparency = 0.65, BorderSizePixel = 0,
        }, intro)
        new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
        table.insert(particles, dot)
    end
    local function animate(object, duration, properties)
        local tween = TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties)
        table.insert(animations, tween)
        tween:Play()
    end
    local function dispose()
        if stopped then return end
        stopped = true
        if frameConnection then frameConnection:Disconnect() end
        for _, tween in ipairs(animations) do tween:Cancel() end
        shade:Destroy()
        picker:Destroy()
        intro:Destroy()
    end
    track({ Disconnect = dispose })
    local function selectGame(name)
        if selected or stopped then return end
        selected = true
        Settings.SelectedGame = name
        gameText.Text = name == "Other" and "Your game  /  ZYNX" or name .. "  /  ZYNX"
        animate(picker, 0.2, { GroupTransparency = 1 })
        task.spawn(function()
            task.wait(0.22)
            if stopped or not Gui.Parent then return end
            picker.Visible = false
            intro.Visible = true
            animate(intro, 0.35, { GroupTransparency = 0 })
            animate(introScale, 0.5, { Scale = 1 })
            frameConnection = RunService.RenderStepped:Connect(function(dt)
                elapsed += dt
                local progress = math.clamp(elapsed/2.4, 0, 1)
                fill.Size = UDim2.fromScale(1-(1-progress)^2, 1)
                percent.Text = tostring(math.floor((1-(1-progress)^2)*100)) .. "%"
                shine.Offset = Vector2.new(math.sin(elapsed*2)*0.8, 0)
                edge.Transparency = 0.25 + 0.15*math.sin(elapsed*3)
                for i, gradient in ipairs(orbitGradients) do gradient.Rotation = elapsed*(i%2 == 0 and -100 or 75)+i*75 end
                for i, dot in ipairs(particles) do
                    local angle = i*math.pi/6 + elapsed*0.2
                    local radius = 85 + (i%3)*9
                    dot.Position = UDim2.fromOffset(200+math.cos(angle)*radius,108+math.sin(angle)*radius)
                end
            end)
            task.wait(2.4)
            if stopped or not Gui.Parent then return end
            gameText.Text = "WELCOME TO SUNSET"
            task.wait(0.22)
            if stopped or not Gui.Parent then return end
            animate(intro, 0.3, { GroupTransparency = 1 })
            animate(introScale, 0.3, { Scale = 1.05 })
            animate(shade, 0.3, { BackgroundTransparency = 1 })
            task.wait(0.32)
            if stopped or not Gui.Parent then return end
            dispose()
            loading = false
            Window.Visible = true
        end)
    end
    gameButton.MouseButton1Click:Connect(function() selectGame("Sniper Duels") end)
    otherButton.MouseButton1Click:Connect(function() selectGame("Other") end)
    gameButton.MouseEnter:Connect(function() if not selected then animate(gameButton, 0.15, { BackgroundColor3 = Color3.fromRGB(53, 28, 37) }) end end)
    gameButton.MouseLeave:Connect(function() if not selected then animate(gameButton, 0.15, { BackgroundColor3 = Color3.fromRGB(35, 23, 30) }) end end)
    otherButton.MouseEnter:Connect(function() if not selected then animate(otherButton, 0.15, { TextColor3 = T.text }) end end)
    otherButton.MouseLeave:Connect(function() if not selected then animate(otherButton, 0.15, { TextColor3 = T.dim }) end end)
    animate(picker, 0.3, { GroupTransparency = 0 })
    animate(pickerScale, 0.4, { Scale = 1 })
end
