        local sleeping = ((os.clock() - (BedWars.FakeLagStarted or os.clock()))
            % cycle) < BedWars.FakeLagHold
        local ok = pcall(setter, root, "NetworkIsSleeping", sleeping)
        if not ok then
            BedWars.FakeLagReset()
            BedWars.FakeLagOn = false
            if BedWars.FakeLagToggle then BedWars.FakeLagToggle.Set(false) end
