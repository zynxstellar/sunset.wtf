        button.TextColor3 = T.red
    end)
    return object
end
-- ============================================================
-- Zombie Survival Arena feature modules. Kept local to this single-file loader.
-- ============================================================
local Zombie = { alive = true }
do
    local storage = game:GetService("ReplicatedStorage")
    local Core = { LocalPlayer = LocalPlayer, ReplicatedStorage = storage }
    function Core.findIn(parent, ...)
        for _, name in ipairs({ ... }) do
            parent = parent and parent:FindFirstChild(name)
        end
        return parent
    end
    local registryModule = Core.findIn(storage, "Modules", "ServiceRegistry")
    local registry
    local function findRegistry()
        if registry then return registry end
        registryModule = registryModule or Core.findIn(storage, "Modules", "ServiceRegistry")
        if registryModule then
            local ok, result = pcall(require, registryModule)
            if ok then registry = result end
        end
        return registry
    end
    findRegistry()
    function Core.getService(name, timeout)
        local serviceRegistry = findRegistry()
        if not serviceRegistry then return nil end
        for _, methodName in ipairs({ "Get", "WaitFor" }) do
            local method = serviceRegistry[methodName]
            if type(method) == "function" then
                -- Some registry versions use colon methods; others expose plain functions.
                for _, useSelf in ipairs({ false, true }) do
                    local ok, result
                    if useSelf then
                        ok, result = pcall(method, serviceRegistry, name, timeout or 2)
                    else
                        ok, result = pcall(method, name, timeout or 2)
                    end
                    if ok and result then return result end
                end
            end
        end
        return nil
    end
    function Core.fireRemote(remote, ...)
        if remote and remote:IsA("RemoteEvent") then
            pcall(remote.FireServer, remote, ...)
        end
    end
    local remoteRoot = storage:FindFirstChild("Remotes")
    Core.GameStateRemotes = remoteRoot and remoteRoot:FindFirstChild("GameStateRemotes")
    Core.WaveRemotes = remoteRoot and remoteRoot:FindFirstChild("WaveRemotes")
    Core.UpgradeRemotes = remoteRoot and remoteRoot:FindFirstChild("UpgradeRemotes")
    Core.GunRemotes = remoteRoot and remoteRoot:FindFirstChild("GunRemotes")
    Core.EventRemotes = remoteRoot and remoteRoot:FindFirstChild("EventRemotes")
    Zombie.Core = Core

    local function remote(folder, name) return folder and folder:FindFirstChild(name) end
    local function flagModule()
        local module = { enabled = false }
        function module.SetEnabled(state) module.enabled = state == true end
        function module.IsEnabled() return module.enabled end
        return module
    end

    local AutoReplay = flagModule()
    Zombie.AutoReplay = AutoReplay
    local replayVote = remote(Core.GameStateRemotes, "VotePlayAgain")
    local voted = false
    local started = remote(Core.GameStateRemotes, "GameOverStarted")
    local ended = remote(Core.GameStateRemotes, "GameOverEnded")
    if started then track(started.OnClientEvent:Connect(function()
        if not Zombie.alive or not AutoReplay.enabled or voted or not replayVote then return end
        voted = true
        task.delay(1, function()
            if Zombie.alive and AutoReplay.enabled then Core.fireRemote(replayVote) end
        end)
    end)) end
    if ended then track(ended.OnClientEvent:Connect(function() voted = false end)) end

    local AutoNextWave = flagModule()
    Zombie.AutoNextWave = AutoNextWave
    local skipVote = remote(Core.WaveRemotes, "SkipVote")
    local skipUpdate = remote(Core.WaveRemotes, "SkipUpdate")
    local nextWaveReady = false
    local gameOver = false
    if started then track(started.OnClientEvent:Connect(function() gameOver = true end)) end
    if ended then track(ended.OnClientEvent:Connect(function() gameOver = false end)) end
    if skipUpdate then track(skipUpdate.OnClientEvent:Connect(function(data)
        if type(data) ~= "table" then return end
        local action = data.Action or data.State
        if action == "SpawningComplete" or action == "WaveComplete"
            or action == "Intermission" or action == "VoteOpen" then
            nextWaveReady = true
        elseif action == "WaveStarted" or action == "SpawningStarted" then
            nextWaveReady = false
        end
    end)) end
    task.spawn(function()
        local settingsClient, zombieClient
        local previousVote
        local lastLookup, lastVote = 0, 0
        while Zombie.alive do
            if os.clock() - lastLookup > 2 then
                lastLookup = os.clock()
                settingsClient = Core.getService("SettingsClient", 2) or settingsClient
                zombieClient = Core.getService("ZombieClient", 2) or zombieClient
            end
            pcall(function()
                if AutoNextWave.enabled then
                    if settingsClient then
                        if previousVote == nil then previousVote = settingsClient:Get("AutoVote") end
                        if settingsClient:Get("AutoVote") ~= true then settingsClient:Set("AutoVote", true) end
                    end
                    local noZombies = false
                    if zombieClient and type(zombieClient.Zombies) == "table" then
                        noZombies = true
                        for _, record in pairs(zombieClient.Zombies) do
                            if record and not record.IsDying and (record.Health == nil or record.Health > 0) then
                                noZombies = false
                                break
                            end
                        end
                    end
                    if not gameOver and skipVote and (nextWaveReady or noZombies)
                        and os.clock() - lastVote >= 2 then
                        Core.fireRemote(skipVote, true)
                        lastVote = os.clock()
                    end
                elseif previousVote ~= nil then
                    if settingsClient then settingsClient:Set("AutoVote", previousVote) end
                    previousVote = nil
                end
            end)
            task.wait(0.5)
        end
        if previousVote ~= nil and settingsClient then
            pcall(function() settingsClient:Set("AutoVote", previousVote) end)
        end
    end)

    local AutoSkipWave = flagModule()
    Zombie.AutoSkipWave = AutoSkipWave
    if skipUpdate then track(skipUpdate.OnClientEvent:Connect(function(data)
        if Zombie.alive and AutoSkipWave.enabled and type(data) == "table"
            and (data.Action == "SpawningComplete" or data.Action == "Update") then
            Core.fireRemote(skipVote, true)
        end
    end)) end
    task.spawn(function()
        while Zombie.alive do
            if AutoSkipWave.enabled then Core.fireRemote(skipVote, true) end
            task.wait(2)
        end
    end)

    local AutoEquip = flagModule()
    Zombie.AutoEquip = AutoEquip
    task.spawn(function()
        while Zombie.alive do
            if AutoEquip.enabled then
