    LieDown.Yaw, LieDown.OriginalAutoRotate = nil, nil
end
local function bedWarsLiePose(character)
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end
    LieDown.Root, LieDown.Humanoid = root, humanoid
    LieDown.OriginalAutoRotate = humanoid.AutoRotate
    local _, yaw = root.CFrame:ToOrientation()
    LieDown.Yaw = yaw
end
