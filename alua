function Settings.CompleteStartup(loading, gameName)
    -- Commit the UI handoff on this thread. A delayed tween must never be the
    -- only way to clear loading, enable the menu key, or show the ready board.
    if not loading or ENV.SunsetLoading ~= loading or not Gui.Parent then return false end
    ENV.SunsetLoading = nil
    if loading.Gui then
        pcall(function() loading.Gui.Enabled = false end)
        pcall(function() loading.Gui:Destroy() end)
    end
    local board = Settings.GameBoards[gameName]
    if board and board.Parent then
        board.Visible = true
    else
        Window.Visible = true
    end
    onMenuVisibility()
    return true
end



