        local names = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and not (Settings.TpTeamCheck and isTeammate(p)) then
                table.insert(names, p.Name)
            end
        end
        table.sort(names)
        if #names == 0 then names = { "none" } end
        return names
    end

