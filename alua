    }, intro)
    local scanner = new("Frame", {
        Position = UDim2.fromOffset(34, 104), Size = UDim2.fromOffset(178, 178),
        BackgroundColor3 = Color3.fromRGB(24, 25, 36), BorderSizePixel = 0,
    }, intro)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, scanner)
    border(scanner, Color3.fromRGB(92, 55, 77), 1)
    local orbitGradients = {}
    for i = 1, 3 do
        local diameter = 62 + i * 35
        local circle = new("Frame", {
            Size = UDim2.fromOffset(diameter, diameter),
            Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 1,
        }, scanner)
        new("UICorner", { CornerRadius = UDim.new(1, 0) }, circle)
        local stroke = border(circle, i == 2 and Color3.fromRGB(248, 138, 104) or T.red,
            i == 2 and 2 or 1)
        local gradient = new("UIGradient", {
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.35, 0.1),
                NumberSequenceKeypoint.new(1, 0.92),
            }),
            Rotation = i * 100,
        }, stroke)
        table.insert(orbitGradients, gradient)
    end
    local monogram = introText(scanner, "S", 51, 46, 76, 86, 60, T.text, Enum.Font.GothamBold)
    monogram.TextXAlignment = Enum.TextXAlignment.Center
    local sweep = new("Frame", {
        Size = UDim2.fromOffset(126, 2), Position = UDim2.fromOffset(26, 88),
        BackgroundColor3 = T.red, BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
    }, scanner)
    local phaseTitle = introText(intro, "DETECTING EXPERIENCE", 240, 105, 252, 24,
        14, T.text, Enum.Font.GothamBold)
    local gameName = introText(intro, detectedGame or "Unknown Roblox game",
        240, 132, 252, 38, 20, T.red, Enum.Font.GothamBold)
    gameName.TextWrapped = true
    local steps = {}
    local stepNames = { "Detect experience", "Verify game modules", "Start Sunset interface" }
    for i, title in ipairs(stepNames) do
        local y = 190 + (i - 1) * 30
        local step = introText(intro, string.format("0%d  %s", i, title),
            240, y, 245, 22, 12, T.dim, Enum.Font.Gotham)
        table.insert(steps, step)
    end
    local progressLabel = introText(intro, "INITIALIZING", 27, 309, 230, 16,
        10, T.dim, Enum.Font.GothamBold)
    local percent = introText(intro, "0%", 444, 308, 48, 16,
        10, T.text, Enum.Font.GothamBold)
    percent.TextXAlignment = Enum.TextXAlignment.Right
    local segments = {}
    for i = 1, 24 do
        local segment = new("Frame", {
            Position = UDim2.fromOffset(27 + (i - 1) * 20, 336),
            Size = UDim2.fromOffset(15, 6), BackgroundColor3 = Color3.fromRGB(45, 44, 55),
            BorderSizePixel = 0,
        }, intro)
        table.insert(segments, segment)
    end
    introText(intro, "Sunset detects the current game automatically", 27, 351, 460, 15,
        10, T.dim)
    local close = new("TextButton", {
        Position = UDim2.fromOffset(240, 258), Size = UDim2.fromOffset(249, 32),
        BackgroundColor3 = Color3.fromRGB(72, 37, 48), BorderSizePixel = 0,
        Text = "CLOSE", Font = Enum.Font.GothamBold, TextSize = 12,
        TextColor3 = T.text, AutoButtonColor = false, Visible = false,
    }, intro)
    new("UICorner", { CornerRadius = UDim.new(0, 6) }, close)
    local function animate(object, duration, properties)
        local tween = TweenService:Create(object,
            TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties)
        table.insert(tweens, tween)
        tween:Play()
    end
    local function dispose()
        if stopped then return end
        stopped = true
        if frameConnection then frameConnection:Disconnect() end
        fitConnection:Disconnect()
        for _, tween in ipairs(tweens) do tween:Cancel() end
        shade:Destroy()
        intro:Destroy()
    end
    track({ Disconnect = dispose })
    close.MouseButton1Click:Connect(function()
        dispose()
        loading = false
        onMenuVisibility()
    end)
    animate(intro, 0.4, { GroupTransparency = 0 })
    frameConnection = RunService.RenderStepped:Connect(function(dt)
        elapsed += dt
        for i, gradient in ipairs(orbitGradients) do
            gradient.Rotation = elapsed * (i % 2 == 0 and -115 or 90) + i * 100
        end
        sweep.Rotation = elapsed * 55
        if not detectedGame then return end
        local progress = math.clamp(elapsed / 2.6, 0, 1)
        percent.Text = tostring(math.floor(progress * 100)) .. "%"
        for i, segment in ipairs(segments) do
            segment.BackgroundColor3 = i <= math.floor(progress * #segments)
                and T.red or Color3.fromRGB(45, 44, 55)
        end
        for i, step in ipairs(steps) do
            step.TextColor3 = progress >= (i - 1) / 3 and T.text or T.dim
        end
        if progress < 0.33 then progressLabel.Text = "IDENTIFYING GAME"
        elseif progress < 0.7 then progressLabel.Text = "LOADING MODULES"
        else progressLabel.Text = "READY TO LAUNCH" end
    end)
    if detectedGame then
        Settings.SelectedGame = detectedGame
        showGameSections(detectedGame)
        Title.Text = "  Sunset.wtf | " .. detectedGame
        task.spawn(function()
            task.wait(2.7)
            if stopped or not Gui.Parent then return end
            progressLabel.Text = "SUNSET IS READY"
            animate(intro, 0.35, { GroupTransparency = 1 })
            animate(shade, 0.35, { BackgroundTransparency = 1 })
            task.wait(0.38)
            if stopped or not Gui.Parent then return end
            dispose()
            loading = false
            Window.Visible = true
        end)
    else
        Zombie.Stop()
        BedWars.Stop()
        phaseTitle.Text = "THIS GAME IS NOT SUPPORTED"
        gameName.Text = "No modules loaded"
        gameName.TextColor3 = Color3.fromRGB(255, 121, 121)
        steps[1].Text = "Supported: BedWars"
        steps[2].Text = "Sniper Arena"
        steps[3].Text = "Survive Zombie Arena"
        progressLabel.Text = "YOU CAN KEEP PLAYING"
        percent.Text = ""
        close.Visible = true
    end
end
