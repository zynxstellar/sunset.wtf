function Settings.ParentColdWarUI(gui)
    local function attach(root)
        if typeof(root) ~= "Instance" then return false end
        local ok, attached = pcall(function()
            gui.Parent = root
            return gui.Parent == root
        end)
        if ok and attached then Settings.ColdWarUIParent = root return true end
        return false
    end
    if attach(Settings.ColdWarUIParent) then return end
    local hidden = type(ENV.gethui) == "function" and ENV.gethui
        or type(gethui) == "function" and gethui or nil
    if hidden then
        local ok, root = pcall(hidden)
        if ok and attach(root) then return end
    end
    local ok, root = pcall(game.GetService, game, "CoreGui")
    if ok and attach(root) then return end
    gui:Destroy()
    error("Rift Cold War UI needs an accessible gethui() or CoreGui container.")
end

