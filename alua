local CustomAnimation = { Enabled = false, AnimationId = "", Loop = false, Generation = 0 }
local customAnimationToggle
function CustomAnimation.Stop()
    CustomAnimation.Generation += 1
    if CustomAnimation.Track then
        pcall(function() CustomAnimation.Track:Stop(0.15) end)
        pcall(function() CustomAnimation.Track:Destroy() end)
        CustomAnimation.Track = nil
    end
    if CustomAnimation.Animation then
        CustomAnimation.Animation:Destroy()
        CustomAnimation.Animation = nil
    end
end
local function playCustomAnimation()
    CustomAnimation.Stop()
    if not CustomAnimation.Enabled then return end
    local id = CustomAnimation.AnimationId
    if not id:match("^%d+$") then return end
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    local generation = CustomAnimation.Generation
    local animator = humanoid:FindFirstChildOfClass("Animator")
        or humanoid:WaitForChild("Animator", 2)
    if generation ~= CustomAnimation.Generation or not CustomAnimation.Enabled or not animator then return end
    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. id
    local ok, animationTrack = pcall(function()
        return animator:LoadAnimation(animation)
    end)
    if not ok or not animationTrack then
        animation:Destroy()
        return
    end
    CustomAnimation.Animation, CustomAnimation.Track = animation, animationTrack
    animationTrack.Priority = Enum.AnimationPriority.Action4
    animationTrack.Looped = CustomAnimation.Loop
    local played = pcall(function() animationTrack:Play(0.15) end)
    if not played then CustomAnimation.Stop() end
end
track(LocalPlayer.CharacterAdded:Connect(function()
    if not CustomAnimation.Enabled then return end
    task.wait(0.5)
    if CustomAnimation.Enabled then playCustomAnimation() end
end))

local LieDown = { Enabled = false, AnimationId = "112195772277805", Generation = 0 }
function LieDown.Stop()
    LieDown.Generation += 1
    if LieDown.Track then
        pcall(function() LieDown.Track:Stop(0.15) end)
        pcall(function() LieDown.Track:Destroy() end)
        LieDown.Track = nil
    end
    if LieDown.Animation then LieDown.Animation:Destroy() LieDown.Animation = nil end
    if LieDown.Root and LieDown.Root.Parent then
        LieDown.Root.CFrame = CFrame.new(LieDown.Root.Position)
            * CFrame.Angles(0, LieDown.Yaw or 0, 0)
        LieDown.Root.AssemblyAngularVelocity = Vector3.zero
    end
    if LieDown.Humanoid and LieDown.Humanoid.Parent then
        LieDown.Humanoid.AutoRotate = LieDown.OriginalAutoRotate
    end
