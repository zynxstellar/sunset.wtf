    function object.SetBind(key)
        key = key or Enum.KeyCode.RightShift -- never leave the menu inaccessible
        for toggle, assigned in pairs(Binds) do
            if assigned == key then toggle.SetBind(nil) end
        end
        Settings.MenuKey = key
