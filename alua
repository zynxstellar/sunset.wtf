                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                local tool = backpack and backpack:FindFirstChildOfClass("Tool")
                if humanoid and tool and not character:FindFirstChildOfClass("Tool") then
                    pcall(humanoid.EquipTool, humanoid, tool)
                end
            end
            task.wait(0.5)
        end
    end)

    local Crosshair = flagModule()
    Zombie.Crosshair = Crosshair
    local crosshairWasEnabled
    function Crosshair.SetEnabled(state)
        Crosshair.enabled = state == true
        local gui = PlayerGui:FindFirstChild("CrosshairGui")
        if Crosshair.enabled then
            if gui and crosshairWasEnabled == nil then crosshairWasEnabled = gui.Enabled end
            if gui then gui.Enabled = false end
        else
            if gui and crosshairWasEnabled ~= nil then gui.Enabled = crosshairWasEnabled end
            crosshairWasEnabled = nil
        end
    end
    task.spawn(function()
        while Zombie.alive do
            if Crosshair.enabled then Crosshair.SetEnabled(true) end
            task.wait(0.25)
        end
    end)

    local Upgrades = { health = false, weapon = false }
    Zombie.Upgrades = Upgrades
    function Upgrades.SetHealthEnabled(state) Upgrades.health = state == true end
    function Upgrades.SetWeaponEnabled(state) Upgrades.weapon = state == true end
    local healthPurchase = remote(Core.UpgradeRemotes, "PurchaseHealthUpgrade")
    local weaponPurchase = remote(Core.UpgradeRemotes, "PurchaseWeaponUpgrade")
    task.spawn(function()
        while Zombie.alive do
            if Upgrades.health then Core.fireRemote(healthPurchase) end
            if Upgrades.weapon then Core.fireRemote(weaponPurchase) end
            task.wait(2)
        end
    end)

    local KillAura = flagModule()
    Zombie.KillAura = KillAura
    local radius, maxTargets = 60, 18
    KillAura.Status = "Off"
    function KillAura.SetRadius(value) radius = math.clamp(tonumber(value) or 60, 10, 200) end
    function KillAura.SetMaxTargets(value) maxTargets = math.clamp(math.floor(tonumber(value) or 18), 1, 30) end
    local hookedGun, originalAim, originalAutoShoot, originalFiring
    local aimRecord
    local function inAimCircle(record)
        local camera = workspace.CurrentCamera
        local model = record and record.Model
        local part = model and (model.PrimaryPart or model:FindFirstChild("Head")
            or model:FindFirstChild("HumanoidRootPart"))
        local position = record and (record.CurrentPosition or (part and part.Position))
        if not camera or not position then return nil end
        if record.HitboxTop then
            position = position + Vector3.new(0,
                (record.HitboxTop - (record.HitboxBottom or 0)) * 0.5, 0)
        end
        local screen, visible = camera:WorldToViewportPoint(position)
        if not visible or screen.Z <= 0 then return nil end
        local center = camera.ViewportSize * 0.5
        if (Vector2.new(screen.X, screen.Y) - center).Magnitude > (Settings.AimFovRadius or 160) then
