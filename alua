    Elements.Dropdown(right, "Fire Input", { "Auto", "Mouse", "Tool" }, "Auto", function(v) Settings.FireBackend = v end)
    Elements.Slider(right, "Click Delay", 5, 100, 15, " x0.01s", function(v) Settings.FireInterval = v / 100 end)

    local parts = {
        Head = { "Head" }, Body = { "UpperTorso", "Torso", "LowerTorso", "HumanoidRootPart", "RootPart" },
        ["Left Arm"] = { "LeftUpperArm", "Left Arm", "LeftHand" },
        ["Right Arm"] = { "RightUpperArm", "Right Arm", "RightHand" },
        ["Left Leg"] = { "LeftUpperLeg", "Left Leg", "LeftFoot" },
        ["Right Leg"] = { "RightUpperLeg", "Right Leg", "RightFoot" },
    }
    local pressMouse = typeof(mouse1press) == "function" and mouse1press or nil
    local releaseMouse = typeof(mouse1release) == "function" and mouse1release or nil
    local focused = true
    local locked, pressedTool, pressedKind, pressedMode
    local releaseAt, nextClick, nextScan = 0, 0, 0
    local function stopFire()
        if pressedKind == "Mouse" and releaseMouse then pcall(releaseMouse) end
        if pressedTool then pcall(function() pressedTool:Deactivate() end) end
        pressedKind, pressedTool, pressedMode = nil, nil, nil
        releaseAt = 0
    end
    track(UIS.WindowFocusReleased:Connect(function() focused = false stopFire() end))
    track(UIS.WindowFocused:Connect(function() focused = true end))
    local function held()
        if Settings.AimMode == "Always" then return true end
        if Settings.AimHoldInput == "Right Mouse" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
        local key = ({ ["Left Alt"] = Enum.KeyCode.LeftAlt, E = Enum.KeyCode.E, Q = Enum.KeyCode.Q })[Settings.AimHoldInput]
        return key and UIS:IsKeyDown(key)
    end
    local function rayClear(origin, part, camera)
        local exclusions = { camera }
        if LocalPlayer.Character then table.insert(exclusions, LocalPlayer.Character) end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        for _ = 1, 12 do
            params.FilterDescendantsInstances = exclusions
            local hit = workspace:Raycast(origin, part.Position - origin, params)
            local targetModel = part:FindFirstAncestorOfClass("Model")
            local owner = targetModel and owningPlayer(targetModel)
            local targetCharacter = owner and owner.Character or targetModel
            if not hit or (targetCharacter and hit.Instance:IsDescendantOf(targetCharacter)) then return true end
            -- Invisible non-solid helpers should not block targeting.
            if hit.Instance:IsA("BasePart") and hit.Instance.Transparency >= 0.95 and not hit.Instance.CanCollide then
                table.insert(exclusions, hit.Instance)
            else
                return false
            end
        end
        return false
    end
    local function candidate(model, camera, origin, retaining)
        if not eligibleModel(model, false) then return nil, "self / dead / missing part" end
        if Settings.AimTeamCheck and teamRelation(model) == "friendly" then return nil, "same team" end
        if Settings.AimTeamCheck and Settings.AimSkipUnknown and teamRelation(model) == "unknown" then return nil, "unset team" end
        local part
        for _, name in ipairs(parts[Settings.TriggerEnabled and "Head" or Settings.AimPart]) do
            part = modelPart(model, name)
            if part then break end
        end
        if not part then return nil, "no body part" end
        local distance = (part.Position - origin).Magnitude
        if distance > Settings.AimRange or distance < 0.01 then return nil, "out of range" end
        local screen, inView = camera:WorldToViewportPoint(part.Position)
        if not retaining and not Settings.AimAllDirections and (not inView or screen.Z <= 0) then return nil, "off screen" end
        if Settings.AimVisibleCheck and not rayClear(camera.CFrame.Position, part, camera) then return nil, "behind wall" end
        local center = camera.ViewportSize * 0.5
        local score = inView and (Vector2.new(screen.X, screen.Y) - center).Magnitude or 100000 + distance
        return part, nil, score
    end
    local function fire(character, now)
        local backend = Settings.FireBackend
        if backend == "Auto" then backend = pressMouse and releaseMouse and "Mouse" or "Tool" end
        local tool = character:FindFirstChildOfClass("Tool")
        if pressedKind and (pressedKind ~= backend or pressedMode ~= Settings.FireMode or (backend == "Tool" and pressedTool ~= tool)) then stopFire() end
        if backend == "Mouse" and not (pressMouse and releaseMouse) then stopFire() return "Mouse input unavailable; use Tool" end
        if backend == "Tool" and not tool then stopFire() return "No equipped tool; custom weapon needs Mouse" end
        if backend == "Tool" and not tool.Enabled then stopFire() return "Tool not ready" end
        if pressedKind then return "Firing: " .. backend end
        if now < nextClick then return "Fire delay" end
        pressedKind, pressedMode = backend, Settings.FireMode
        pressedTool = backend == "Tool" and tool or nil
        local ok
        if backend == "Mouse" then ok = pcall(pressMouse) else ok = pcall(function() tool:Activate() end) end
        if not ok then stopFire() return "Fire input failed: " .. backend end
        if Settings.FireMode == "Click" then
            releaseAt = now + 0.05
            nextClick = now + math.max(Settings.FireInterval, 0.08)
        end
        return "Firing: " .. backend
    end
    -- Preserve our previous aim rotation, not the rotation rewritten by the
    -- game's camera at the start of each frame. Camera position still follows
    -- the game's movement, zoom and respawn behavior.
    local trackedCamera, trackedRotation
    local function resetTracking()
        trackedCamera, trackedRotation = nil, nil
    end
    local function trackCamera(camera, point, dt)
        local origin = camera.CFrame.Position
        if (point - origin).Magnitude < 0.01 then return nil end
        if trackedCamera ~= camera or not trackedRotation then
            trackedCamera = camera
            trackedRotation = camera.CFrame.Rotation
        end
        local desired = CFrame.lookAt(origin, point)
        local alpha = Settings.AimSmoothTime <= 0 and 1
            or 1 - math.exp(-math.clamp(dt, 0, 0.05) / Settings.AimSmoothTime)
        trackedRotation = trackedRotation:Lerp(desired.Rotation, alpha)
        local look = CFrame.new(origin) * trackedRotation
        camera.CFrame = look
        return look
    end
    local function pause(message)
        stopFire()
        locked = nil
        resetTracking()
        status.Text = message
    end
    local binding = "SunsetSelectedPartAim"
    RunService:UnbindFromRenderStep(binding)
    local nextRefresh = 0
    local function updateAim(dt)
        local now = os.clock()
        if releaseAt > 0 and now >= releaseAt then stopFire() end
        if not Settings.AimEnabled and not Settings.TriggerEnabled then pause("Off") return end
        if not focused then pause("Paused: game not focused") return end
        if Window.Visible then pause("Close menu with " .. Settings.MenuKey.Name .. " to aim") return end
        if UIS:GetFocusedTextBox() or listeningFor then pause("Paused: typing") return end
        if not held() then pause("Hold " .. Settings.AimHoldInput .. " to aim") nextScan = 0 return end
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
        local camera = workspace.CurrentCamera
        if not camera or not root or not humanoid or humanoid.Health <= 0 then pause("Waiting for your character") return end
        local target = locked
        local part = target and candidate(target, camera, root.Position, true)
        if not part then
            stopFire()
            locked = nil
            if now < nextScan then return end
            nextScan = now + 0.06
            if now >= nextRefresh then
                nextRefresh = now + 2
                -- Also find parts renamed after creation or streamed in during loading.
                for _, descendant in ipairs(workspace:GetDescendants()) do registerTargetPart(descendant) end
            end
            local best, count, reasons = math.huge, 0, {}
            for model in pairs(TargetModels) do
                local point, why, score = candidate(model, camera, root.Position)
                count += 1
                if point and score < best then target, part, best = model, point, score end
                if why then reasons[why] = (reasons[why] or 0) + 1 end
            end
            if not part then
                local details = {}
                for why, amount in pairs(reasons) do table.insert(details, tostring(amount) .. " " .. why) end
                table.sort(details)
                resetTracking()
                status.Text = count == 0 and "No heads found in loaded models"
                    or "No lock: " .. table.concat(details, ", ")
                return
            end
            locked = target
        end
        local look = trackCamera(camera, part.Position, dt)
        if not look then stopFire() return end
        -- Keep the existing cursor-unlock fallback from undoing this rotation.
        if useScriptable then camOffset = root.CFrame:ToObjectSpace(look) end
        local relation = teamRelation(target)
        status.Text = "LOCKED: " .. target.Name .. " | " .. relation
        if Settings.TriggerEnabled then
            local direction = part.Position - look.Position
            local allowedAngle = math.max(math.rad(2), math.atan(math.min(part.Size.X, part.Size.Y) * 0.45 / direction.Magnitude))
            local aligned = look.LookVector:Dot(direction.Unit) >= math.cos(allowedAngle)
            if aligned then status.Text = status.Text .. "\n" .. fire(character, now)
            else stopFire() status.Text = status.Text .. " | lining up" end
        else stopFire() end
    end
    RunService:BindToRenderStep(binding, Enum.RenderPriority.Last.Value + 1, function(dt)
        aimStatus.Visible = Settings.AimEnabled or Settings.TriggerEnabled
        local ok, message = pcall(updateAim, dt)
        if not ok then
            stopFire()
            locked = nil
            resetTracking()
            status.Text = "Aim error: " .. tostring(message)
        end
    end)
    track({ Disconnect = function()
        Settings.AimEnabled, Settings.TriggerEnabled = false, false
        resetTracking()
        stopFire()
        RunService:UnbindFromRenderStep(binding)
    end })
end
