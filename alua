        local character = LocalPlayer.Character
        local root = active and character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = active and character and character:FindFirstChildOfClass("Humanoid")
        if root ~= BedWars.FakeLagRoot then BedWars.FakeLagReset() end
        if not root or not humanoid or humanoid.Health <= 0 then return end
        local setter = BedWars.SleepingSetter()
        if not setter then
