            hookedGun.GetAimDirection = originalAim
            hookedGun.IsAutoShooting = originalAutoShoot
            if hookedGun.IsFiring then
                hookedGun.IsFiring = originalFiring == true
                    or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                    or hookedGun.ControllerShootHeld == true
            end
        end
        hookedGun, originalAim, originalAutoShoot, originalFiring, aimRecord = nil, nil, nil, nil, nil
    end
    function KillAura.SetEnabled(state)
        KillAura.enabled = state == true
