        if currentTab then
            currentTab.Page.Visible = false
            currentTab.Button.TextColor3 = T.dim
            currentTab.Stroke.Color = T.border
        end
        currentTab = tab
        page.Visible = true
        btn.TextColor3 = T.text
        stroke.Color = T.red
    end

    btn.MouseButton1Click:Connect(tab.Select)
    return tab
end

