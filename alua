            eventDrops[anchor] = nil
        end
    end
    function DropMarkers.SetEnabled(state)
        DropMarkers.enabled = state == true
        if not DropMarkers.enabled then clearDrops() end
    end
    local function dropPart(object)
        if object:IsA("BasePart") then return object end
        if object:IsA("Model") then
            return object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
        end
        return nil
    end
    local function dropKind(object)
        local name = object.Name:lower()
        if name:find("salvage", 1, true) then return "SALVAGE" end
        if name:find("shard", 1, true) then return "SHARD" end
        return nil
    end
    local function eventPosition(value)
        if typeof(value) == "Vector3" then return value end
        if typeof(value) == "CFrame" then return value.Position end
        if typeof(value) == "Instance" then
            local part = dropPart(value)
            return part and part.Position
        end
        if type(value) == "table" then
            for _, key in ipairs({ "Position", "WorldPosition", "CFrame", "Model", "Part", "Instance" }) do
                local position = eventPosition(value[key])
                if position then return position end
            end
        end
        return nil
    end
    for _, entry in ipairs({
        { "SalvageDrop", "SALVAGE" },
        { "FactionWarShardDrop", "SHARD" },
        { "FrontierShardDrop", "SHARD" },
    }) do
        local signal = remote(Core.EventRemotes, entry[1])
        if signal and signal:IsA("RemoteEvent") then
            track(signal.OnClientEvent:Connect(function(...)
                if not DropMarkers.enabled then return end
                local position
                local payload = table.pack(...)
                for i = 1, payload.n do
                    position = eventPosition(payload[i])
                    if position then break end
                end
                if not position then return end
                local anchor = Instance.new("Part")
                anchor.Name = "SunsetDropPosition"
                anchor.Size = Vector3.new(0.1, 0.1, 0.1)
                anchor.Transparency = 1
                anchor.Anchored = true
                anchor.CanCollide = false
                anchor.CanTouch = false
                anchor.CFrame = CFrame.new(position)
                anchor.Parent = workspace
                local gui = Instance.new("BillboardGui")
                gui.Name = "SunsetDropEvent"
                gui.Adornee = anchor
                gui.AlwaysOnTop = true
                gui.Size = UDim2.fromOffset(120, 26)
                gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
                gui.MaxDistance = 600
                gui.Parent = anchor
