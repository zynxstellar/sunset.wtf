        LightEmission = 1, Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.15),
            NumberSequenceKeypoint.new(1, 1),
        }) }, orb)
    Fun.Active[orb] = "projectile"
    local destination = target.Position + Vector3.new(0, 1, 0)
