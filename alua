                label.Size = UDim2.fromScale(1, 1)
                label.BackgroundTransparency = 1
                label.Font = Enum.Font.GothamBold
                label.TextSize = 12
                label.TextStrokeTransparency = 0.2
                label.TextColor3 = entry[2] == "SHARD"
                    and Color3.fromRGB(123, 211, 255)
                    or Color3.fromRGB(255, 207, 112)
                label.Text = entry[2]
                label.Parent = gui
                eventDrops[anchor] = { Gui = gui, Expires = os.clock() + 45 }
            end))
