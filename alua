local function startBedWarsLieDown()
    LieDown.Stop()
    if not LieDown.Enabled or Settings.SelectedGame ~= "BedWars" then return end
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    bedWarsLiePose(character)
    local generation = LieDown.Generation
    local animator = humanoid:FindFirstChildOfClass("Animator")
        or humanoid:WaitForChild("Animator", 2)
    if generation ~= LieDown.Generation or not LieDown.Enabled then return end
    if not animator then return end
    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. LieDown.AnimationId
    local ok, animationTrack = pcall(function()
        return animator:LoadAnimation(animation)
    end)
    if not ok or not animationTrack then
        animation:Destroy()
        return
    end
    LieDown.Animation, LieDown.Track = animation, animationTrack
    animationTrack.Priority = Enum.AnimationPriority.Action4
    animationTrack.Looped = true
    local played = pcall(function() animationTrack:Play(0.15) end)
    if not played then
        pcall(function() animationTrack:Destroy() end)
        animation:Destroy()
        LieDown.Track, LieDown.Animation = nil, nil
    end
end
