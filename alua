local Fly = {}
do
    local bv, bg, conn, physicsConn, postPhysicsConn, flightRoot
    local desiredVelocity = Vector3.zero
    local idlePosition = nil

    local function getRoot()
        local char = LocalPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
    end

    function Fly.Start()
        if game.PlaceId == 6872265039 or game.GameId == 2619619496
            or Settings.SelectedGame == "BedWars" then
            Settings.FlyEnabled = false
            Fly.Stop()
            return
        end
        local root, hum = getRoot()
        if not root then return end
        Fly.Stop()
        flightRoot = root
        idlePosition = root.Position
        hum.PlatformStand = true
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        bv = new("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero }, root)
        bg = new("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 1e4, CFrame = root.CFrame }, root)

        local function enforceFlight()
            if not flightRoot or not flightRoot.Parent then return end
            if desiredVelocity.Magnitude < 0.01 and idlePosition then
                -- Gun recoil and other scripts can move the root even with zero velocity.
                -- Keep the position fixed until the player presses a movement key.
                flightRoot.CFrame = CFrame.new(idlePosition) * flightRoot.CFrame.Rotation
                flightRoot.AssemblyLinearVelocity = Vector3.zero
            else
                idlePosition = flightRoot.Position
                flightRoot.AssemblyLinearVelocity = desiredVelocity
            end
            flightRoot.AssemblyAngularVelocity = Vector3.zero
        end
        physicsConn = RunService.Stepped:Connect(enforceFlight)
        postPhysicsConn = RunService.Heartbeat:Connect(enforceFlight)

        conn = RunService.RenderStepped:Connect(function()
            if not root.Parent then Fly.Stop() return end
            local dir = Vector3.zero
            local cf = Camera.CFrame
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
            if dir.Magnitude > 0 then dir = dir.Unit end
            if desiredVelocity.Magnitude < 0.01 and dir.Magnitude > 0 then
                idlePosition = root.Position
            elseif desiredVelocity.Magnitude > 0 and dir.Magnitude == 0 then
                idlePosition = root.Position
            end
            desiredVelocity = dir * Settings.FlySpeed
            bv.Velocity = desiredVelocity
            bg.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z))
        end)
    end

    function Fly.Stop()
        if conn then conn:Disconnect() conn = nil end
        if physicsConn then physicsConn:Disconnect() physicsConn = nil end
        if postPhysicsConn then postPhysicsConn:Disconnect() postPhysicsConn = nil end
        if bv then bv:Destroy() bv = nil end
        if bg then bg:Destroy() bg = nil end
        if flightRoot and flightRoot.Parent then
            flightRoot.AssemblyLinearVelocity = Vector3.zero
            flightRoot.AssemblyAngularVelocity = Vector3.zero
        end
        flightRoot = nil
        idlePosition = nil
        desiredVelocity = Vector3.zero
        local _, hum = getRoot()
        if hum then hum.PlatformStand = false end
    end

    -- re-apply after respawn
    track(LocalPlayer.CharacterAdded:Connect(function(char)
        char:WaitForChild("HumanoidRootPart")
        task.wait(0.5)
        if Settings.FlyEnabled and game.GameId ~= 2619619496 then Fly.Start() end
    end))
end

