-- Free the cursor while the menu is open, even in first person.
-- While open: camera goes Scriptable (so the camera scripts stop re-locking the mouse and the
-- view stops spinning under the cursor), CameraMode is forced to Classic, and MouseBehavior is
-- pinned to Default every frame after the camera step. Everything is restored on close.
-- With hookmetamethod available we can stop other scripts re-locking the mouse directly, so the
-- camera is left alone and keeps following the character (important for teleports).
-- Without it we fall back to a Scriptable camera that we move ourselves to follow the character.
local canHook = typeof(hookmetamethod) == "function" and typeof(newcclosure) == "function" and typeof(checkcaller) == "function"
local useScriptable = not canHook

local savedCamType, savedCamMode, camOffset = nil, nil, nil

local function onMenuVisibility()
    if Window.Visible or loading then
        if savedCamMode ~= nil then return end
        savedCamMode = LocalPlayer.CameraMode
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        if useScriptable then
            savedCamType = Camera.CameraType
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            camOffset = root and root.CFrame:ToObjectSpace(Camera.CFrame) or nil
            Camera.CameraType = Enum.CameraType.Scriptable
        end
        UIS.MouseBehavior = Enum.MouseBehavior.Default
        UIS.MouseIconEnabled = true
    else
        if savedCamType then Camera.CameraType = savedCamType end
        if savedCamMode then LocalPlayer.CameraMode = savedCamMode end
        savedCamType, savedCamMode, camOffset = nil, nil, nil
    end
end
track(Window:GetPropertyChangedSignal("Visible"):Connect(onMenuVisibility))

local function forceUnlock()
    if not Window.Visible and not loading then return end
    if useScriptable then
        if Camera.CameraType ~= Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Scriptable
        end
        -- keep the frozen camera glued to the character so teleports are visible
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root and camOffset then
            Camera.CFrame = root.CFrame * camOffset
        end
    end
    if UIS.MouseBehavior ~= Enum.MouseBehavior.Default then
        UIS.MouseBehavior = Enum.MouseBehavior.Default
    end
    UIS.MouseIconEnabled = true
end

-- hit every stage of the frame so whatever re-locks the mouse gets undone right after
local UNLOCK_NAME = "SunsetCursorUnlock"
pcall(RunService.UnbindFromRenderStep, RunService, UNLOCK_NAME)
RunService:BindToRenderStep(UNLOCK_NAME, Enum.RenderPriority.Last.Value, forceUnlock)
track(RunService.Stepped:Connect(forceUnlock))
track(RunService.Heartbeat:Connect(forceUnlock))

-- Executor-only extra: block other scripts from setting MouseBehavior / CameraType while open.
if canHook then
    local oldNewIndex
    oldNewIndex = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
        if not checkcaller() and Window and Window.Parent and (Window.Visible or loading) then
            if self == UIS and key == "MouseBehavior" then
                value = Enum.MouseBehavior.Default
            end
        end
        return oldNewIndex(self, key, value)
    end))
end

track({ Disconnect = function()
    pcall(RunService.UnbindFromRenderStep, RunService, UNLOCK_NAME)
    if savedCamType then Camera.CameraType = savedCamType end
    if savedCamMode then LocalPlayer.CameraMode = savedCamMode end
end })

