    local KillAura = flagModule()
    Zombie.KillAura = KillAura
    local radius, maxTargets = 60, 18
    KillAura.Status = "Off"
    function KillAura.SetRadius(value) radius = math.clamp(tonumber(value) or 60, 10, 200) end
    function KillAura.SetMaxTargets(value) maxTargets = math.clamp(math.floor(tonumber(value) or 18), 1, 30) end
    local hookedGun, originalAim, originalAutoShoot, originalFiring
    local aimRecord
    local function inAimCircle(record)
        local camera = workspace.CurrentCamera
        local model = record and record.Model
        local part = model and (model.PrimaryPart or model:FindFirstChild("Head")
            or model:FindFirstChild("HumanoidRootPart"))
        local position = record and (record.CurrentPosition or (part and part.Position))
        if not camera or not position then return nil end
        if record.HitboxTop then
            position = position + Vector3.new(0,
                (record.HitboxTop - (record.HitboxBottom or 0)) * 0.5, 0)
        end
        local screen, visible = camera:WorldToViewportPoint(position)
        if not visible or screen.Z <= 0 then return nil end
        local center = camera.ViewportSize * 0.5
        if (Vector2.new(screen.X, screen.Y) - center).Magnitude > (Settings.AimFovRadius or 160) then
            return nil
        end
        return position
    end
    local function releaseGun()
        if hookedGun then
            hookedGun.GetAimDirection = originalAim
            hookedGun.IsAutoShooting = originalAutoShoot
            if hookedGun.IsFiring then
                hookedGun.IsFiring = originalFiring == true
                    or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                    or hookedGun.ControllerShootHeld == true
            end
        end
        hookedGun, originalAim, originalAutoShoot, originalFiring, aimRecord = nil, nil, nil, nil, nil
    end
    function KillAura.SetEnabled(state)
        KillAura.enabled = state == true
        if not KillAura.enabled then
            releaseGun()
            KillAura.Status = "Off"
        end
    end
    task.spawn(function()
        local zombieClient, gunClient
        local lastLookup = 0
        while Zombie.alive do
            if KillAura.enabled then
                if os.clock() - lastLookup > 2 then
                    lastLookup = os.clock()
                    zombieClient = Core.getService("ZombieClient", 2) or zombieClient
                    gunClient = Core.getService("GunClient", 2) or gunClient
                end
                if not zombieClient then
                    releaseGun()
                    KillAura.Status = "ZombieClient unavailable"
                elseif not gunClient then
                    releaseGun()
                    KillAura.Status = "GunClient unavailable"
                else
                local ok, err = pcall(function()
                    local character = LocalPlayer.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    local equipped = gunClient.EquippedGun
                    local config = gunClient.EquippedConfig
                    if not root then
                        releaseGun()
                        KillAura.Status = "Waiting for character"
                    elseif not equipped or not config then
                        releaseGun()
                        KillAura.Status = "Equip a gun"
                    elseif type(gunClient.GetAimDirection) ~= "function" then
                        releaseGun()
                        KillAura.Status = "Gun aiming unavailable"
                    else
                        local weaponRange = radius
                        if config.IsMelee then weaponRange = math.min(radius, 15) end
                        if config.IsCone then weaponRange = math.min(radius,
                            tonumber(config.Range or config.MaxRange) or 45) end
                        local ids = zombieClient:GetNearbyZombieIds(root.Position, weaponRange)
                        local alive = {}
                        for _, id in ipairs(ids or {}) do
                            local record = zombieClient.Zombies and zombieClient.Zombies[id]
                            local model = record and record.Model
                            local position = inAimCircle(record)
                            if record and position and model and model.Parent and not record.IsDying
                                and (record.Health == nil or record.Health > 0)
                                and (position - root.Position).Magnitude <= weaponRange then
                                table.insert(alive, { record = record,
                                    distance = (position - root.Position).Magnitude })
                            end
                        end
                        table.sort(alive, function(a, b) return a.distance < b.distance end)
                        local count = math.min(#alive, maxTargets)
                        if count == 0 then
                            releaseGun()
                            KillAura.Status = "No nearby zombies"
                        elseif type(gunClient.CanFire) ~= "function" or not gunClient:CanFire() then
                            releaseGun()
                            KillAura.Status = "Gun not ready to fire"
                        else
                            if gunClient ~= hookedGun then
                                releaseGun()
                                hookedGun = gunClient
                                originalAim = rawget(gunClient, "GetAimDirection")
                                originalAutoShoot = gunClient.IsAutoShooting
                                originalFiring = gunClient.IsFiring
                                gunClient.GetAimDirection = function(self, ...)
                                    local record = aimRecord
                                    if record and not record.IsDying and self.EquippedGun then
                                        local origin = self:GetFireOrigin()
                                        local target = inAimCircle(record)
                                        local targetPart = record.Model and
                                            (record.Model.PrimaryPart or record.Model:FindFirstChild("HumanoidRootPart"))
                                        local speed = tonumber(self.EquippedConfig and
                                            (self.EquippedConfig.BulletSpeed or self.EquippedConfig.ProjectileSpeed))
                                        if target and origin and targetPart and speed and speed > 1 then
                                            local travel = math.clamp((target - origin).Magnitude / speed, 0, 0.5)
                                            target = target + targetPart.AssemblyLinearVelocity * travel
                                        end
                                        local delta = origin and target and (target - origin)
                                        if delta and delta.Magnitude > 0.01 then
                                            if self.EquippedConfig and self.EquippedConfig.IsMelee then
                                                delta = Vector3.new(delta.X, 0, delta.Z)
                                                if delta.Magnitude <= 0.01 then return nil end
                                            end
                                            return delta.Unit
                                        end
                                    end
                                    return originalAim and originalAim(self, ...) or nil
                                end
                            end
                            local stillValid = false
                            for i = 1, count do
                                if alive[i].record == aimRecord then stillValid = true break end
                            end
                            if not stillValid then
                                aimRecord = alive[1].record
                            end
                            gunClient.IsAutoShooting = true
                            gunClient.IsFiring = true
                            local before = gunClient.LastFireTime or 0
                            gunClient:TryFire()
                            local shotStarted = (gunClient.LastFireTime or 0) > before
                                or tick() - (gunClient.LastFireTime or 0) < 0.5
                            local bullets = gunClient.ActiveBullets and #gunClient.ActiveBullets or 0
                            KillAura.Status = (shotStarted and "Firing" or "Aiming")
                                .. " | Bullets: " .. bullets .. " | Targets: " .. count
                        end
                    end
                end)
                if not ok then
                    releaseGun()
                    KillAura.Status = "Error: " .. tostring(err):sub(1, 90)
                end
                end
            else
                releaseGun()
                KillAura.Status = "Off"
            end
            task.wait(0.25)
        end
        releaseGun()
    end)

