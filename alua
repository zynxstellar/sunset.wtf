local function bedWarsScaffoldStep()
    if BedWars.ItemBusy then return end
    if BedWars.ProjectilePriorityUntil
        and os.clock() < BedWars.ProjectilePriorityUntil then return end
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local item = bedWarsFindWool()
    local remote = bedWarsRemote("PlaceBlock", true)
    if not root or not humanoid or humanoid.Health <= 0
        or not remote or not remote:IsA("RemoteFunction") then return end
    local feetY = root.Position.Y - root.Size.Y / 2 - humanoid.HipHeight
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = { character }
    local ray = RaycastParams.new()
    ray.FilterType = Enum.RaycastFilterType.Exclude
    ray.FilterDescendantsInstances = { character }
    ray.RespectCanCollide = true
    local function emptyCell(position)
        local grid = Vector3.new(math.round(position.X / 3), math.round((feetY - 1.5) / 3), math.round(position.Z / 3))
        local center = grid * 3
        for _, part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(2.6, 2.6, 2.6), overlap)) do
            if part.CanCollide then return nil end
        end
        -- Check only the space immediately below the feet; distant ground
        -- must not stop a bridge block from being placed over a gap.
        if workspace:Raycast(Vector3.new(position.X, feetY + 0.35, position.Z), Vector3.new(0, -2.4, 0), ray) then
            return nil
        end
        return grid
    end
    local grid = emptyCell(root.Position)
    if not grid and humanoid.MoveDirection.Magnitude >= 0.05 then
        grid = emptyCell(root.Position + humanoid.MoveDirection.Unit * 3.5)
    end
    if not grid then return end
    -- Keep bridging when the block path is over a deep gap; otherwise let
    -- nearby combat take priority and leave the player's held item alone.
    local gapOrigin = grid * 3 + Vector3.new(0, 1.5, 0)
    local groundBelow = workspace:Raycast(gapOrigin, Vector3.new(0, -24, 0), ray)
    local overVoid = not groundBelow or (gapOrigin.Y - groundBelow.Position.Y) > 12
    if not overVoid and bedWarsEnemyInSwordRange(root) then return end
    if not item then return end
    BedWars.BridgingNeeded = os.clock()
    local key = tostring(grid.X) .. ":" .. tostring(grid.Y) .. ":" .. tostring(grid.Z)
    BedWars.ScaffoldAttempts = BedWars.ScaffoldAttempts or {}
    local now = os.clock()
    if (BedWars.ScaffoldAttempts[key] or 0) + 0.12 > now
        or (BedWars.ScaffoldPending or 0) >= 3 then return end
    BedWars.ScaffoldAttempts[key] = now
    BedWars.ScaffoldPending = (BedWars.ScaffoldPending or 0) + 1
    BedWars.ItemBusy = true
    task.spawn(function()
        pcall(function()
            if not BedWars.Running or not BedWars.ScaffoldOn then return end
            local previous = bedWarsHeldItem()
            if previous and previous ~= item and not BedWars.ScaffoldPreviousItem then
                BedWars.ScaffoldPreviousItem = previous
            end
            if not bedWarsEquip(item) then return end
            BedWars.ScaffoldWoolItem = item
            if item.Parent == bedWarsInventory() and bedWarsHeldItem() == item then
                pcall(function()
                    remote:InvokeServer({ blockType = item.Name, position = grid })
                end)
            end
        end)
        BedWars.ScaffoldPending = math.max(0, (BedWars.ScaffoldPending or 1) - 1)
        BedWars.ItemBusy = false
    end)
end
