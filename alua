-- BedWars starter modules use replicated players and map objects. No lobby
-- remotes are fired, so the controls remain useful after entering a match.
BedWars = {
    PlayersOn = false, BedsOn = false, GeneratorsOn = false, TeamCheck = true,
    Running = true, AuraOn = false, ScaffoldOn = false,
}
local bedWarsNet = game:GetService("ReplicatedStorage"):FindFirstChild("rbxts_include")
local function bedWarsRemote(name, blockEngine)
    local root = bedWarsNet and bedWarsNet:FindFirstChild("node_modules")
    if blockEngine then
        local games = root and root:FindFirstChild("@easy-games")
        local engine = games and games:FindFirstChild("block-engine")
        root = engine and engine:FindFirstChild("node_modules")
    end
    local rbxts = root and root:FindFirstChild("@rbxts")
    local net = rbxts and rbxts:FindFirstChild("net")
    local out = net and net:FindFirstChild("out")
    local managed = out and out:FindFirstChild("_NetManaged")
    return managed and managed:FindFirstChild(name)
end
local function bedWarsHeldItem()
    local character = LocalPlayer.Character
    local hand = character and character:FindFirstChild("HandInvItem")
    local item = hand and hand.Value
    return typeof(item) == "Instance" and item or nil
end
local function bedWarsInventory()
    local character = LocalPlayer.Character
    local inventoryValue = character and character:FindFirstChild("InventoryFolder")
    local inventory = inventoryValue and inventoryValue.Value
    if inventory then return inventory end
    local folders = game:GetService("ReplicatedStorage"):FindFirstChild("Inventories")
    return folders and folders:FindFirstChild(LocalPlayer.Name)
end
local function bedWarsEquip(item)
    local equip = bedWarsRemote("SetInvItem", false)
    if not item or not equip or not equip:IsA("RemoteFunction") then return end
    local now = os.clock()
    if (BedWars.LastEquipTime or 0) + 0.25 > now then return end
    BedWars.LastEquipTime = now
    pcall(function() equip:InvokeServer({ hand = item }) end)
end
local function bedWarsAttackRange()
    local ts = game:GetService("ReplicatedStorage"):FindFirstChild("TS")
    local combat = ts and ts:FindFirstChild("combat")
    local module = combat and combat:FindFirstChild("combat-constant")
    if module then
        local ok, data = pcall(require, module)
        local value = ok and data.CombatConstant and data.CombatConstant.RAYCAST_SWORD_CHARACTER_DISTANCE
        if type(value) == "number" then return value end
    end
    return 14.4
end
local function bedWarsMeleeItem(item)
    if not item then return false end
    local ts = game:GetService("ReplicatedStorage"):FindFirstChild("TS")
    local games = ts and ts:FindFirstChild("games")
    local bedwars = games and games:FindFirstChild("bedwars")
    local swords = bedwars and bedwars:FindFirstChild("bedwars-swords")
    if swords then
        local ok, data = pcall(require, swords)
        if ok and type(data.BedwarsMelees) == "table" then
            if table.find(data.BedwarsMelees, item.Name) then return true end
        end
    end
    local name = string.lower(item.Name)
    return string.find(name, "sword", 1, true) ~= nil
        or string.find(name, "blade", 1, true) ~= nil
        or string.find(name, "scythe", 1, true) ~= nil
end
local function bedWarsBestSword()
    local inventory = bedWarsInventory()
    if not inventory then return nil end
    local best, rank = nil, 0
    local priority = { wood = 1, stone = 2, iron = 3, diamond = 4, emerald = 5 }
    for _, item in ipairs(inventory:GetChildren()) do
        if bedWarsMeleeItem(item) then
            local tier = 1
            for material, score in pairs(priority) do
                if string.find(string.lower(item.Name), material, 1, true) then
                    tier = score
                    break
                end
            end
            if tier > rank then best, rank = item, tier end
        end
    end
    return best
end
local bedWarsWoolColors = {
    red = true, blue = true, green = true, yellow = true, orange = true,
    purple = true, pink = true, cyan = true, white = true, black = true,
    gray = true, grey = true, brown = true, lime = true,
}
local function bedWarsWoolItem(item)
    if not item then return false end
    local name = string.lower(item.Name)
    if string.find(name, "wool", 1, true) then return true end
    local color = name:match("^wood_(%a+)$")
    return color ~= nil and bedWarsWoolColors[color] == true
end
local function bedWarsFindWool()
    local inventory = bedWarsInventory()
    if not inventory then return nil end
    for _, item in ipairs(inventory:GetChildren()) do
        if bedWarsWoolItem(item) then return item end
    end
    return nil
end
local function bedWarsEnemy(player)
    if player == LocalPlayer then return false end
    if LocalPlayer.Team and player.Team then return player.Team ~= LocalPlayer.Team end
    if not LocalPlayer.Neutral and not player.Neutral then
        return player.TeamColor ~= LocalPlayer.TeamColor
    end
    return player.Character and teamRelation(player.Character) == "enemy"
end
local function bedWarsAuraStep()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local weapon = bedWarsHeldItem()
    local remote = bedWarsRemote("SwordHit", false)
    if not root or not humanoid or humanoid.Health <= 0
        or not remote or not remote:IsA("RemoteEvent") then return end
    if not bedWarsMeleeItem(weapon) then
        -- BedWars keeps swords in InventoryFolder even while another item is held.
        -- Equip once, then let the next tick attack with the actual hand item.
        if BedWars.ScaffoldOn and os.clock() - (BedWars.BridgingNeeded or -1e9) < 0.4 then return end
        local sword = bedWarsBestSword()
        bedWarsEquip(sword)
        return
    end
    local range = bedWarsAttackRange()
    local closest, closestRoot, distance = nil, nil, range
    for _, player in ipairs(Players:GetPlayers()) do
        if bedWarsEnemy(player) then
            local target = player.Character
            local targetHumanoid = target and target:FindFirstChildOfClass("Humanoid")
            local targetRoot = target and target:FindFirstChild("HumanoidRootPart")
            if targetHumanoid and targetHumanoid.Health > 0 and targetRoot
                and not target:FindFirstChildOfClass("ForceField") then
                local d = (root.Position - targetRoot.Position).Magnitude
                if d < distance then
                    closest, closestRoot, distance = target, targetRoot, d
                end
            end
        end
    end
    if closest then
        pcall(function()
            remote:FireServer({
                weapon = weapon,
                entityInstance = closest,
                chargedAttack = { chargeRatio = 0 },
                validate = {
                    selfPosition = { value = root.Position },
                    targetPosition = { value = closestRoot.Position },
                },
            })
        end)
    end
end
local function bedWarsScaffoldStep()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local item = bedWarsHeldItem()
    local remote = bedWarsRemote("PlaceBlock", true)
    if not root or not humanoid or humanoid.Health <= 0
        or humanoid.MoveDirection.Magnitude < 0.05
        or not remote or not remote:IsA("RemoteFunction") then return end
    -- Look one cell ahead so the request reaches the server before the player steps off.
    local ahead = root.Position + humanoid.MoveDirection.Unit * 3.5
    local feetY = root.Position.Y - root.Size.Y / 2 - humanoid.HipHeight
    local grid = Vector3.new(math.round(ahead.X / 3), math.round((feetY - 1.5) / 3), math.round(ahead.Z / 3))
    local center = grid * 3
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = { character }
    for _, part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(2.6, 2.6, 2.6), overlap)) do
        if part.CanCollide then return end
    end
    -- A normal floor or an existing bridge below the next step needs no block.
    local ray = RaycastParams.new()
    ray.FilterType = Enum.RaycastFilterType.Exclude
    ray.FilterDescendantsInstances = { character }
    ray.RespectCanCollide = true
    if workspace:Raycast(Vector3.new(ahead.X, feetY + 0.5, ahead.Z), Vector3.new(0, -8, 0), ray) then
        return
    end
    BedWars.BridgingNeeded = os.clock()
    if not bedWarsWoolItem(item) then
        bedWarsEquip(bedWarsFindWool())
        return
    end
    local key = tostring(grid.X) .. ":" .. tostring(grid.Y) .. ":" .. tostring(grid.Z)
    BedWars.ScaffoldAttempts = BedWars.ScaffoldAttempts or {}
    local now = os.clock()
    if (BedWars.ScaffoldAttempts[key] or 0) + 0.3 > now
        or (BedWars.ScaffoldPending or 0) >= 3 then return end
    BedWars.ScaffoldAttempts[key] = now
    BedWars.ScaffoldPending = (BedWars.ScaffoldPending or 0) + 1
    task.spawn(function()
        if BedWars.Running and BedWars.ScaffoldOn then
            pcall(function()
                remote:InvokeServer({ blockType = item.Name, position = grid })
            end)
        end
        BedWars.ScaffoldPending = math.max(0, (BedWars.ScaffoldPending or 1) - 1)
    end)
end
local bedWarsMarks = { Players = {}, Beds = {}, Generators = {} }
local function clearBedWarsMarks(kind)
    for target, mark in pairs(bedWarsMarks[kind]) do
        mark:Destroy()
        bedWarsMarks[kind][target] = nil
    end
end
local function setBedWarsMark(kind, target, color)
    local mark = bedWarsMarks[kind][target]
    if not mark then
        mark = new("Highlight", {
            Name = "SunsetBedWars" .. kind, Adornee = target,
            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
            FillTransparency = 0.78, OutlineTransparency = 0,
        }, workspace)
        bedWarsMarks[kind][target] = mark
    end
    mark.FillColor = color
    mark.OutlineColor = color
end
local function refreshBedWarsPlayers()
    local seen = {}
    if BedWars.PlayersOn then
        for _, player in ipairs(Players:GetPlayers()) do
            local model = player.Character
            local humanoid = model and model:FindFirstChildOfClass("Humanoid")
            local teammate = BedWars.TeamCheck and model
                and teamRelation(model) == "friendly"
            if player ~= LocalPlayer and model and humanoid and humanoid.Health > 0
                and not teammate then
                seen[model] = true
                setBedWarsMark("Players", model, Settings.EspBoxColor)
            end
        end
    end
    for model, mark in pairs(bedWarsMarks.Players) do
        if not seen[model] or not model.Parent then
            mark:Destroy()
            bedWarsMarks.Players[model] = nil
        end
    end
end
local function refreshBedWarsMap()
    if not BedWars.BedsOn then clearBedWarsMarks("Beds") end
    if not BedWars.GeneratorsOn then clearBedWarsMarks("Generators") end
    if not BedWars.BedsOn and not BedWars.GeneratorsOn then return end
    local seenBeds, seenGenerators = {}, {}
    local count = 0
    for _, node in ipairs(workspace:GetDescendants()) do
        if node:IsA("BasePart") or node:IsA("Model") then
            local name = string.lower(node.Name)
            local parent = node.Parent
            local parentName = parent and string.lower(parent.Name) or ""
            if BedWars.BedsOn and name == "bed" and parentName ~= "bed" then
                seenBeds[node] = true
                setBedWarsMark("Beds", node, Color3.fromRGB(255, 204, 82))
                count += 1
            elseif BedWars.GeneratorsOn and string.find(name, "generator", 1, true)
                and not string.find(parentName, "generator", 1, true) then
                seenGenerators[node] = true
                setBedWarsMark("Generators", node, Color3.fromRGB(82, 220, 255))
                count += 1
            end
            if count >= 80 then break end
        end
    end
    for target, mark in pairs(bedWarsMarks.Beds) do
        if not seenBeds[target] or not target.Parent then
            mark:Destroy()
            bedWarsMarks.Beds[target] = nil
        end
    end
    for target, mark in pairs(bedWarsMarks.Generators) do
        if not seenGenerators[target] or not target.Parent then
            mark:Destroy()
            bedWarsMarks.Generators[target] = nil
        end
    end
end
function BedWars.Stop()
