local Fly = {}
do
    local bv, bg, conn, flightRoot, flightHumanoid, originalPlatformStand
    local desiredVelocity = Vector3.zero

    local function getRoot()
        local char = LocalPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
    end

    function Fly.Start()
        if game.PlaceId == 6872265039 or game.GameId == 2619619496
            or Settings.SelectedGame == "BedWars" then
            Settings.FlyEnabled = false
            Fly.Stop()
            return
        end
        local root, hum = getRoot()
        if not root or not hum or hum.Health <= 0 or root.Anchored then return end
        Fly.Stop(false)
        flightRoot = root
        flightHumanoid, originalPlatformStand = hum, hum.PlatformStand
        hum.PlatformStand = true
        root.AssemblyAngularVelocity = Vector3.zero
        bv = new("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero }, root)
        bg = new("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 1e4, CFrame = root.CFrame }, root)

        conn = RunService.RenderStepped:Connect(function()
            if not root.Parent or hum.Health <= 0 then Fly.Stop(false) return end
            local dir = Vector3.zero
            local camera = workspace.CurrentCamera
            if not camera then return end
            local cf = camera.CFrame
            if not anyMenuVisible() and not UIS:GetFocusedTextBox() then
                if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
                if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
            end
            if dir.Magnitude > 0 then dir = dir.Unit end
            desiredVelocity = dir * Settings.FlySpeed
            bv.Velocity = desiredVelocity
            local facing = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
            if facing.Magnitude > 0.001 then bg.CFrame = CFrame.lookAt(root.Position, root.Position + facing) end
        end)
    end

    function Fly.Stop(coast)
        if conn then conn:Disconnect() conn = nil end
        if bv then bv:Destroy() bv = nil end
        if bg then bg:Destroy() bg = nil end
        if flightRoot and flightRoot.Parent then
            flightRoot.AssemblyLinearVelocity = coast == false and Vector3.zero
                or desiredVelocity * Settings.FlyCoast
            flightRoot.AssemblyAngularVelocity = Vector3.zero
        end
        flightRoot = nil
        desiredVelocity = Vector3.zero
        if flightHumanoid and flightHumanoid.Parent then flightHumanoid.PlatformStand = originalPlatformStand end
        flightHumanoid, originalPlatformStand = nil, nil
    end


    track(LocalPlayer.CharacterAdded:Connect(function(char)
        char:WaitForChild("HumanoidRootPart")
        task.wait(0.5)
        if Settings.FlyEnabled and game.GameId ~= 2619619496 then Fly.Start() end
    end))
end



